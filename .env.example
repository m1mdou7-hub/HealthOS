SUPABASE_AUTH_EXTERNAL_GITHUB_REDIRECT_URI="http://127.0.0.1:54321/auth/v1/callback"
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# Set to 'true' to explicitly force authentication bypass even if NODE_ENV is not 'development'
NEXT_PUBLIC_DEV_BYPASS_AUTH=

# Stripe Environment Variables (Support both test and live environments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_LIVE=
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=

# Gemini API Key (Server-side only)
GEMINI_API_KEY=
# Public Nexa licensing API used by HealthOS device activation and verification.
NEXT_PUBLIC_NEXA_API_URL=https://nexa-subscriptions.tennis-zag-3c.chatgpt.site
